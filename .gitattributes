# Normalize all text files to LF in the repo and on checkout.
* text=auto eol=lf

# Explicit binary types (never touch these).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.snk binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
