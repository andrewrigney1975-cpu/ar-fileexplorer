<Window
    x:Class="FileExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileExplorer.ViewModels"
    xmlns:views="using:FileExplorer.Views"
    xmlns:models="using:FileExplorer.Models"
    xmlns:conv="using:FileExplorer.Converters">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:ViewModeToBoolConverter x:Key="ViewModeToBool" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="TerminalRow" Height="0" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="File Explorer" FontWeight="SemiBold" FontSize="16"
                       VerticalAlignment="Center" Margin="4,0,16,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="IconsModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Icons view"
                              IsChecked="{Binding SelectedTab.ActivePane.ViewMode, Converter={StaticResource ViewModeToBool}, ConverterParameter=Icons, Mode=OneWay}"
                              Click="IconsModeButton_Click" ToolTipService.ToolTip="Icons view">
                    <FontIcon Glyph="&#xE80A;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="ListModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="List view"
                              IsChecked="{Binding SelectedTab.ActivePane.ViewMode, Converter={StaticResource ViewModeToBool}, ConverterParameter=List, Mode=OneWay}"
                              Click="ListModeButton_Click" ToolTipService.ToolTip="List view">
                    <FontIcon Glyph="&#xE71D;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="DetailsModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Details view"
                              IsChecked="{Binding SelectedTab.ActivePane.ViewMode, Converter={StaticResource ViewModeToBool}, ConverterParameter=Details, Mode=OneWay}"
                              Click="DetailsModeButton_Click" ToolTipService.ToolTip="Details view">
                    <FontIcon Glyph="&#xE71D;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="PreviewToggleButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Toggle preview pane"
                              IsChecked="True" Click="PreviewToggleButton_Click" ToolTipService.ToolTip="Toggle preview pane">
                    <FontIcon Glyph="&#xE890;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="TerminalToggleButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Toggle terminal"
                              IsChecked="False" Click="TerminalToggleButton_Click" ToolTipService.ToolTip="Toggle terminal">
                    <FontIcon Glyph="&#xE756;" FontSize="16" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Body: left rail | main content | right preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="420" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="240" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- Left rail: drives + folder tree -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="This PC" FontWeight="SemiBold" Margin="12,10,12,4" />
                <TreeView x:Name="DriveTree" Grid.Row="1" Margin="4,0,4,4"
                          SelectionMode="Single"
                          ItemInvoked="DriveTree_ItemInvoked"
                          Expanding="DriveTree_Expanding">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14" FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Main content: tabs, each hosting a dual pane -->
            <TabView x:Name="MainTabView" Grid.Column="1"
                     TabItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     TabCloseRequested="MainTabView_TabCloseRequested"
                     CanDragTabs="False" CanReorderTabs="False">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:TabViewModel">
                        <TabViewItem Header="{x:Bind Header, Mode=OneWay}" IsClosable="True">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE8B7;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.Content>
                                <Grid ColumnSpacing="6" Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:PaneView Grid.Column="0" ViewModel="{x:Bind LeftPane, Mode=OneWay}"
                                                     Loaded="PaneView_Loaded" />
                                    <views:PaneView Grid.Column="1" ViewModel="{x:Bind RightPane, Mode=OneWay}"
                                                     Loaded="PaneView_Loaded" />
                                </Grid>
                            </TabViewItem.Content>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>

            <!-- Right rail: preview -->
            <views:PreviewPane x:Name="Preview" Grid.Column="2" />
        </Grid>

        <!-- Bottom drawer: terminal -->
        <views:TerminalPane x:Name="Terminal" Grid.Row="2"
                             GoToActiveFolderRequested="Terminal_GoToActiveFolderRequested" />
    </Grid>
</Window>
