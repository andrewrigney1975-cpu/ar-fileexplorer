<Window
    x:Class="FileExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileExplorer.ViewModels"
    xmlns:views="using:FileExplorer.Views"
    xmlns:models="using:FileExplorer.Models"
    xmlns:conv="using:FileExplorer.Converters">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:UsedPercentToBrushConverter x:Key="UsedPercentToBrush" />

            <!-- Spins the File operations gear icon while at least one job is queued/running. -->
            <Storyboard x:Key="OperationsGearSpin">
                <DoubleAnimation Storyboard.TargetName="OperationsGearRotation" Storyboard.TargetProperty="Angle"
                                  From="0" To="360" Duration="0:0:0.5" RepeatBehavior="Forever" />
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="AppTitleBarRow" Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="TerminalRow" Height="0" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="CommandPaletteAccelerator_Invoked" />
            <!-- Driven by the active pane's tracked selection (ActivePane.SelectedItems), not
                 literal keyboard focus - a routed-KeyDown handler on the ListView never fires after
                 a marquee-drag multi-select, since dragging over empty space never focuses it. -->
            <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="ShiftDeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="F2" Invoked="RenameAccelerator_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="MoveToFolderAccelerator_Invoked" />
            <KeyboardAccelerator Key="F4" Invoked="FindDuplicatesAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="TogglePreviewAccelerator_Invoked" />
            <KeyboardAccelerator Key="F7" Invoked="ToggleTerminalAccelerator_Invoked" />
            <KeyboardAccelerator Key="F8" Invoked="ChecksumAccelerator_Invoked" />
            <KeyboardAccelerator Key="F9" Invoked="SearchEverywhereAccelerator_Invoked" />
            <KeyboardAccelerator Key="F10" Invoked="ControlCentreAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="PreviousTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Right" Invoked="ForwardAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Up" Invoked="UpAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number1" Invoked="IconsViewAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number2" Invoked="ListViewAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number3" Invoked="DetailsViewAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Number4" Invoked="GalleryViewAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Custom title bar: extends app content (and its Mica backdrop) up into the OS caption area
             so the window frame reads as one continuous surface instead of a separate white/black strip. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" />
                <TextBlock Text="enfyl Explorer" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" x:Name="CommandPaletteBar" Width="360" Height="32" CornerRadius="6"
                    HorizontalAlignment="Center" Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Tapped="CommandPaletteBar_Tapped"
                    AutomationProperties.Name="Command Palette">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="12" Opacity="0.6" />
                    <TextBlock Text="Command Palette (Ctrl+K)" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button x:Name="UndoButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo"
                        Click="UndoButton_Click" IsEnabled="False">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Rectangle Width="1" Margin="4,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="CutButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Cut" ToolTipService.ToolTip="Cut"
                        Click="CutButton_Click">
                    <FontIcon Glyph="&#xE8C6;" FontSize="16" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="X" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Copy" ToolTipService.ToolTip="Copy"
                        Click="CopyButton_Click">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="PasteButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Paste" ToolTipService.ToolTip="Paste"
                        Click="PasteButton_Click">
                    <FontIcon Glyph="&#xE77F;" FontSize="16" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Rectangle Width="1" Margin="4,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="NewFolderButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="New folder" ToolTipService.ToolTip="New folder"
                        Click="NewFolderButton_Click">
                    <FontIcon Glyph="&#xE8DE;" FontSize="16" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Rectangle Width="1" Margin="4,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="DiskSpaceAnalyserButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Disk space analyser" ToolTipService.ToolTip="Disk space analyser"
                        Click="DiskSpaceAnalyserButton_Click">
                    <FontIcon Glyph="&#xEB05;" FontSize="16" />
                </Button>
                <Button x:Name="DiskBenchmarkButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Disk benchmark" ToolTipService.ToolTip="Disk benchmark"
                        Click="DiskBenchmarkButton_Click">
                    <FontIcon Glyph="&#xE95E;" FontSize="16" />
                </Button>
                <Button x:Name="DiskActivityMonitorButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Disk activity monitor" ToolTipService.ToolTip="Disk activity monitor"
                        Click="DiskActivityMonitorButton_Click">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="IconsModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Icons view"
                              Click="IconsModeButton_Click" ToolTipService.ToolTip="Icons view">
                    <FontIcon Glyph="&#xE80A;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="ListModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="List view"
                              Click="ListModeButton_Click" ToolTipService.ToolTip="List view">
                    <FontIcon Glyph="&#xE71D;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="DetailsModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Details view"
                              Click="DetailsModeButton_Click" ToolTipService.ToolTip="Details view">
                    <FontIcon Glyph="&#xE71D;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="GalleryModeButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Gallery view"
                              Click="GalleryModeButton_Click" ToolTipService.ToolTip="Gallery view">
                    <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="PreviewToggleButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Toggle preview pane"
                              IsChecked="True" Click="PreviewToggleButton_Click" ToolTipService.ToolTip="Toggle preview pane">
                    <FontIcon Glyph="&#xE890;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="TerminalToggleButton" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                              AutomationProperties.Name="Toggle terminal"
                              IsChecked="False" Click="TerminalToggleButton_Click" ToolTipService.ToolTip="Toggle terminal">
                    <FontIcon Glyph="&#xE756;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="SyncButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="Sync tasks"
                        ToolTipService.ToolTip="Sync tasks">
                    <FontIcon Glyph="&#xE895;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="280" Spacing="4">
                                <TextBlock Text="Sync tasks" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock x:Name="SyncTasksEmptyText" Text="No sync tasks" Opacity="0.6" FontSize="12" />
                                <ListView x:Name="SyncTasksList" MaxHeight="360" SelectionMode="None"
                                          AutomationProperties.Name="Sync tasks list"
                                          IsItemClickEnabled="True" ItemClick="SyncTasksList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                                                        Padding="4" Click="DeleteSyncTask_Click" Tag="{Binding}"
                                                        AutomationProperties.Name="Delete sync task"
                                                        ToolTipService.ToolTip="Delete sync task">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="OperationsButton" Style="{StaticResource ToolbarIconButtonStyle}"
                        AutomationProperties.Name="File operations"
                        ToolTipService.ToolTip="File operations">
                    <FontIcon x:Name="OperationsGearIcon" Glyph="&#xE713;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform x:Name="OperationsGearRotation" Angle="0" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="360" Spacing="4">
                                <TextBlock Text="File operations" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ListView x:Name="OperationsList" MaxHeight="360" SelectionMode="None"
                                          AutomationProperties.Name="File operations list">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,6" ColumnSpacing="8" RowSpacing="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                                                        Padding="4" Click="CancelJob_Click" Tag="{Binding}"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                        AutomationProperties.Name="Cancel job"
                                                        ToolTipService.ToolTip="Cancel">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                </Button>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" />
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body: left rail | main content | right preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="240" MinWidth="180" MaxWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="240" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- Left rail: drives + folder tree + saved searches -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="This PC" FontWeight="SemiBold" Margin="12,10,12,4" />
                <TreeView x:Name="DriveTree" Grid.Row="1" Margin="4,0,4,4"
                          SelectionMode="Single"
                          AutomationProperties.Name="Drives and folders"
                          ItemInvoked="DriveTree_ItemInvoked"
                          Expanding="DriveTree_Expanding">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Spacing="2" Padding="0,2">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open in new workspace" Click="OpenDriveInNewWorkspace_Click"
                                                         Visibility="{Binding Content.IsDrive, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem Text="Analyse Disk" Click="AnalyseDiskMenuItem_Click"
                                                         Visibility="{Binding Content.IsDrive, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem Text="Benchmark Disk" Click="BenchmarkDiskMenuItem_Click"
                                                         Visibility="{Binding Content.IsDrive, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem Text="Analyse Folder..." Click="AnalyseFolderMenuItem_Click"
                                                         Visibility="{Binding Content.IsDrive, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    </MenuFlyout>
                                </StackPanel.ContextFlyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14" FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Spacing="1" Margin="20,0,4,0"
                                            Visibility="{Binding Content.UsedPercent, Converter={StaticResource NullToVis}}">
                                    <ProgressBar Value="{Binding Content.UsedPercent}" Minimum="0" Maximum="100"
                                                 Foreground="{Binding Content.UsedPercent, Converter={StaticResource UsedPercentToBrush}}"
                                                 Height="4" />
                                    <TextBlock Text="{Binding Content.UsageText}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Rectangle Grid.Row="2" Height="1" Margin="8,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="3" Background="Transparent" Margin="4,4,8,4" Tapped="FavouritesHeader_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="FavouritesChevron" Grid.Column="0" Glyph="&#xE70D;" FontSize="10"
                              Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Favourites" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="AddFavouriteButton_Click"
                            AutomationProperties.Name="Add favourite"
                            ToolTipService.ToolTip="Pin the active pane's folder to Favourites">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView Grid.Row="4" x:Name="FavouritesList" Margin="4,0,4,4" MaxHeight="200"
                          AutomationProperties.Name="Favourites list"
                          SelectionMode="None" ItemClick="FavouritesList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE734;" FontSize="14" FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                                        Click="RemoveFavouriteButton_Click" Tag="{Binding}"
                                        AutomationProperties.Name="Remove favourite"
                                        ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Rectangle Grid.Row="5" Height="1" Margin="8,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="6" Background="Transparent" Margin="4,4,8,4" Tapped="SavedSearchesHeader_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SavedSearchesChevron" Grid.Column="0" Glyph="&#xE70D;" FontSize="10"
                              Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Saved Searches" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="SaveCurrentSearchButton_Click"
                            AutomationProperties.Name="Save current search"
                            ToolTipService.ToolTip="Save the active pane's search">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView Grid.Row="7" x:Name="SavedSearchesList" Margin="4,0,4,4" MaxHeight="200"
                          AutomationProperties.Name="Saved searches list"
                          SelectionMode="None" ItemClick="SavedSearchesList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                                        Click="RemoveSavedSearchButton_Click" Tag="{Binding}"
                                        AutomationProperties.Name="Remove saved search"
                                        ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Rectangle Grid.Row="8" Height="1" Margin="8,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="9" Background="Transparent" Margin="4,4,8,4" Tapped="NetworkLocationsHeader_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="NetworkLocationsChevron" Grid.Column="0" Glyph="&#xE70D;" FontSize="10"
                              Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Network Locations" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="MapNetworkDriveButton_Click"
                            AutomationProperties.Name="Map network drive"
                            ToolTipService.ToolTip="Map a network drive letter...">
                        <FontIcon Glyph="&#xE71B;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="AddNetworkLocationButton_Click"
                            AutomationProperties.Name="Add network location"
                            ToolTipService.ToolTip="Add a network location (\\server\share)">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView Grid.Row="10" x:Name="NetworkLocationsList" Margin="4,0,4,4" MaxHeight="200"
                          AutomationProperties.Name="Network locations list"
                          SelectionMode="None" ItemClick="NetworkLocationsList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE968;" FontSize="14" FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                                        Click="RemoveNetworkLocationButton_Click" Tag="{Binding}"
                                        AutomationProperties.Name="Remove network location"
                                        ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Rectangle Grid.Row="11" Height="1" Margin="8,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="12" Background="Transparent" Margin="4,4,8,4" Tapped="CloudLocationsHeader_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="CloudLocationsChevron" Grid.Column="0" Glyph="&#xE70D;" FontSize="10"
                              Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Cloud Storage" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <ListView Grid.Row="13" x:Name="CloudLocationsList" Margin="4,0,4,4" MaxHeight="200"
                          AutomationProperties.Name="Cloud storage locations list"
                          SelectionMode="None" ItemClick="CloudLocationsList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="14" FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Rectangle Grid.Row="14" Height="1" Margin="8,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="15" Background="Transparent" Margin="4,4,8,4" Tapped="RemoteConnectionsHeader_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="RemoteConnectionsChevron" Grid.Column="0" Glyph="&#xE70D;" FontSize="10"
                              Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Remote Connections" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="AddRemoteConnectionButton_Click"
                            AutomationProperties.Name="Add remote connection"
                            ToolTipService.ToolTip="Add an FTP/SFTP connection">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView Grid.Row="16" x:Name="RemoteConnectionsList" Margin="4,0,4,4" MaxHeight="200"
                          AutomationProperties.Name="Remote connections list"
                          SelectionMode="None" ItemClick="RemoteConnectionsList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE968;" FontSize="14" FontFamily="Segoe Fluent Icons"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                                        Click="RemoveRemoteConnectionButton_Click" Tag="{Binding}"
                                        AutomationProperties.Name="Remove remote connection"
                                        ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Rectangle Grid.Row="17" Height="1" Margin="8,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="18" Background="Transparent" Margin="4,4,8,4" Tapped="DiskActivityHeader_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DiskActivityChevron" Grid.Column="0" Glyph="&#xE70D;" FontSize="10"
                              Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Disk Activity" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <!-- No numeric readout by design - purely a glance-able "something is happening"
                     indicator, aggregated across every drive; the full per-drive breakdown with
                     numbers lives in the Disk Activity Monitor dialog (toolbar icon). -->
                <Border Grid.Row="19" x:Name="RailDiskActivityHost" Height="48" Margin="8,0,8,8" CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        SizeChanged="RailDiskActivityHost_SizeChanged">
                    <Canvas x:Name="RailDiskActivityCanvas" AutomationProperties.Name="Aggregated disk activity" />
                </Border>
            </Grid>

            <!-- Rail splitter -->
            <Rectangle Grid.Column="1" x:Name="RailSplitter" Width="6" HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Main content: tabs, each hosting a dual pane -->
            <TabView x:Name="MainTabView" Grid.Column="2"
                     AutomationProperties.Name="Workspaces"
                     TabItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     TabCloseRequested="MainTabView_TabCloseRequested"
                     TabItemsChanged="MainTabView_TabItemsChanged"
                     CanDragTabs="True" CanReorderTabs="True">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:TabViewModel">
                        <TabViewItem Header="{x:Bind Header, Mode=OneWay}" IsClosable="True"
                                     AllowDrop="True"
                                     DragEnter="TabViewItem_DragEnter"
                                     DragLeave="TabViewItem_DragLeave"
                                     DoubleTapped="TabViewItem_DoubleTapped">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE8B7;" />
                            </TabViewItem.IconSource>
                            <TabViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename Workspace..." Click="RenameTabMenuItem_Click" />
                                    <MenuFlyoutItem Text="Duplicate Workspace" Click="DuplicateTabMenuItem_Click" />
                                </MenuFlyout>
                            </TabViewItem.ContextFlyout>
                            <TabViewItem.Content>
                                <Grid Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <views:PaneView Grid.Column="0" ViewModel="{x:Bind LeftPane, Mode=OneWay}"
                                                     Loaded="PaneView_Loaded" />
                                    <Rectangle Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                               Loaded="PaneSplitter_Loaded" />
                                    <views:PaneView Grid.Column="2" ViewModel="{x:Bind RightPane, Mode=OneWay}"
                                                     Loaded="PaneView_Loaded" />
                                </Grid>
                            </TabViewItem.Content>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>

            <!-- Preview splitter -->
            <Rectangle Grid.Column="3" x:Name="PreviewSplitter" Width="6" HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Right rail: preview -->
            <views:PreviewPane x:Name="Preview" Grid.Column="4" />
        </Grid>

        <!-- Bottom drawer: terminal -->
        <views:TerminalPane x:Name="Terminal" Grid.Row="3"
                             GoToActiveFolderRequested="Terminal_GoToActiveFolderRequested" />

        <Popup x:Name="CommandPalettePopup" IsLightDismissEnabled="True" LightDismissOverlayMode="On">
            <Border Width="520" Background="{ThemeResource SolidBackgroundFillColorBase}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                    CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="CommandPaletteBox" Margin="10"
                              PlaceholderText="Type a command or a folder path..."
                              AutomationProperties.Name="Command palette input"
                              TextChanged="CommandPaletteBox_TextChanged" KeyDown="CommandPaletteBox_KeyDown" />
                    <ListView Grid.Row="1" x:Name="CommandPaletteList" MaxHeight="360"
                              AutomationProperties.Name="Command palette results"
                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="CommandPaletteList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,6">
                                    <TextBlock Text="{Binding Title}" FontSize="13" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
