<UserControl
    x:Class="FileExplorer.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FileExplorer.Models"
    xmlns:conv="using:FileExplorer.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ActivePaneHighlightConverter x:Key="ActiveBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <DataTemplate x:Key="IconsTemplate" x:DataType="models:FileSystemItem">
            <StackPanel Width="96" Margin="6" Spacing="4" HorizontalAlignment="Center">
                <Grid Width="48" Height="48" HorizontalAlignment="Center" Loaded="ThumbnailHost_Loaded">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                           Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                </Grid>
                <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate" x:DataType="models:FileSystemItem">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,6" VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DetailsTemplate" x:DataType="models:FileSystemItem">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{x:Bind Kind}" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1.5" CornerRadius="6" PointerPressed="RootGrid_PointerPressed"
          BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Path / navigation bar -->
        <Grid Grid.Row="0" Padding="6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding NavigateBackCommand}" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding NavigateForwardCommand}" ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding NavigateUpCommand}" ToolTipService.ToolTip="Up one level">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <TextBox Grid.Column="3" x:Name="PathBox" Text="{Binding CurrentPath, Mode=OneWay}"
                      VerticalAlignment="Center" KeyDown="PathBox_KeyDown" Margin="4,0" />

            <Button Grid.Column="4" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Details column header (only visible in Details mode) -->
        <Grid x:Name="DetailsHeader" Grid.Row="1" Padding="10,4" ColumnSpacing="8" Visibility="Collapsed"
              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Name" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="Date modified" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Column="2" Text="Type" FontSize="12" Opacity="0.7" />
            <TextBlock Grid.Column="3" Text="Size" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
        </Grid>

        <ListView x:Name="ItemsList" Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  CanReorderItems="False"
                  AllowDrop="True"
                  IsItemClickEnabled="False"
                  DragItemsStarting="ItemsList_DragItemsStarting"
                  DragOver="ItemsList_DragOver"
                  DragLeave="ItemsList_DragLeave"
                  Drop="ItemsList_Drop"
                  DoubleTapped="ItemsList_DoubleTapped"
                  SelectionChanged="ItemsList_SelectionChanged"
                  KeyDown="ItemsList_KeyDown"
                  RightTapped="ItemsList_RightTapped" />

        <Popup x:Name="RenamePopup" IsLightDismissEnabled="True">
            <Border Background="{ThemeResource SolidBackgroundFillColorBase}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1.5" CornerRadius="4" Padding="4">
                <TextBox x:Name="RenameTextBox" MinWidth="200"
                         KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
