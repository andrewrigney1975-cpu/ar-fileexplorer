<UserControl
    x:Class="FileExplorer.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FileExplorer.Models"
    xmlns:conv="using:FileExplorer.Converters"
    xmlns:views="using:FileExplorer.Views">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ActivePaneHighlightConverter x:Key="ActiveBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:TagColorToBrushConverter x:Key="TagBrush" />
        <conv:SyncRoleToBrushConverter x:Key="SyncBrush" />

        <DataTemplate x:Key="IconsTemplate" x:DataType="models:FileSystemItem">
            <StackPanel Width="96" Margin="6" Spacing="4" HorizontalAlignment="Center">
                <Grid Width="48" Height="48" HorizontalAlignment="Center" Loaded="ThumbnailHost_Loaded">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                           Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="{x:Bind TagColor, Converter={StaticResource TagBrush}}"
                             Visibility="{x:Bind TagColor, Converter={StaticResource NullToVis}}"
                             Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1" />
                    <Rectangle Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" RadiusX="2" RadiusY="2"
                               Fill="{x:Bind SyncRole, Converter={StaticResource SyncBrush}}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                    <FontIcon Glyph="{x:Bind CloudBadge, Mode=OneWay}" FontSize="11" FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                              Visibility="{x:Bind CloudBadge, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate" x:DataType="models:FileSystemItem">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,6" VerticalAlignment="Center">
                <Rectangle Width="4" VerticalAlignment="Stretch" Margin="-4,-6,0,-6"
                           Fill="{x:Bind SyncRole, Converter={StaticResource SyncBrush}}" />
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{x:Bind TagColor, Converter={StaticResource TagBrush}}"
                         Visibility="{x:Bind TagColor, Converter={StaticResource NullToVis}}" />
                <FontIcon Glyph="{x:Bind CloudBadge, Mode=OneWay}" FontSize="12" FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                          Visibility="{x:Bind CloudBadge, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DetailsTemplate" x:DataType="models:FileSystemItem">
            <Grid Padding="4,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="4" VerticalAlignment="Stretch" Margin="-4,-6,0,-6" HorizontalAlignment="Left"
                           Fill="{x:Bind SyncRole, Converter={StaticResource SyncBrush}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0" Margin="8,0,0,0">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{x:Bind TagColor, Converter={StaticResource TagBrush}}"
                             Visibility="{x:Bind TagColor, Converter={StaticResource NullToVis}}" />
                    <FontIcon Glyph="{x:Bind CloudBadge, Mode=OneWay}" FontSize="12" FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                              Visibility="{x:Bind CloudBadge, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{x:Bind Kind}" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GalleryTemplate" x:DataType="models:FileSystemItem">
            <StackPanel Width="200" Margin="8" Spacing="6" HorizontalAlignment="Center">
                <Grid Width="184" Height="184" CornerRadius="6" Loaded="ThumbnailHost_Loaded"
                      Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                           Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    <Ellipse Width="14" Height="14" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="{x:Bind TagColor, Converter={StaticResource TagBrush}}"
                             Visibility="{x:Bind TagColor, Converter={StaticResource NullToVis}}"
                             Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1.5" />
                    <Rectangle Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                               Fill="{x:Bind SyncRole, Converter={StaticResource SyncBrush}}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                    <FontIcon Glyph="{x:Bind CloudBadge, Mode=OneWay}" FontSize="11" FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                              Visibility="{x:Bind CloudBadge, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderThickness="1.5" CornerRadius="6" PointerPressed="RootGrid_PointerPressed"
          BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Path / navigation bar -->
        <Grid Grid.Row="0" Padding="6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding NavigateBackCommand}" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding NavigateForwardCommand}" ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding NavigateUpCommand}" ToolTipService.ToolTip="Up one level">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <Grid Grid.Column="3" Margin="4,0">
                <Border x:Name="BreadcrumbHost" Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="4" Padding="8,0" MinHeight="32" Tapped="BreadcrumbHost_Tapped">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Stretch" VerticalContentAlignment="Center">
                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>
                <TextBox x:Name="PathBox" Text="{Binding CurrentPath, Mode=OneWay}" Visibility="Collapsed"
                          VerticalAlignment="Center" KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus" />
            </Grid>

            <TextBox Grid.Column="4" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="Search this folder" VerticalAlignment="Center"
                     KeyDown="SearchBox_KeyDown" />

            <ToggleButton Grid.Column="5" Style="{StaticResource ToolbarIconToggleButtonStyle}"
                          IsChecked="{Binding IsRecursiveSearch, Mode=TwoWay}"
                          ToolTipService.ToolTip="Search subfolders and file contents">
                <FontIcon Glyph="&#xE773;" FontSize="14" />
            </ToggleButton>

            <Button Grid.Column="6" Style="{StaticResource ToolbarIconButtonStyle}"
                    Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Details column header (only visible in Details mode) -->
        <Grid x:Name="DetailsHeader" Grid.Row="1" Padding="10,4" ColumnSpacing="8" Visibility="Collapsed"
              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="Transparent" Tapped="NameHeader_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Name" FontSize="12" Opacity="0.7" />
                    <FontIcon x:Name="NameSortIcon" FontSize="10" Opacity="0.7" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Background="Transparent" Tapped="ModifiedHeader_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Date modified" FontSize="12" Opacity="0.7" />
                    <FontIcon x:Name="ModifiedSortIcon" FontSize="10" Opacity="0.7" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2" Background="Transparent" Tapped="KindHeader_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Type" FontSize="12" Opacity="0.7" />
                    <FontIcon x:Name="KindSortIcon" FontSize="10" Opacity="0.7" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="3" Background="Transparent" Tapped="SizeHeader_Tapped" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon x:Name="SizeSortIcon" FontSize="10" Opacity="0.7" Visibility="Collapsed" />
                    <TextBlock Text="Size" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Grid>

        <ListView x:Name="ItemsList" Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  CanReorderItems="False"
                  AllowDrop="True"
                  IsItemClickEnabled="False"
                  DragItemsStarting="ItemsList_DragItemsStarting"
                  DragOver="ItemsList_DragOver"
                  DragLeave="ItemsList_DragLeave"
                  Drop="ItemsList_Drop"
                  DoubleTapped="ItemsList_DoubleTapped"
                  SelectionChanged="ItemsList_SelectionChanged"
                  ContextRequested="ItemsList_ContextRequested" />

        <Popup x:Name="RenamePopup" IsLightDismissEnabled="True">
            <Border Background="{ThemeResource SolidBackgroundFillColorBase}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1.5" CornerRadius="4" Padding="4">
                <TextBox x:Name="RenameTextBox" MinWidth="200"
                         KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" />
            </Border>
        </Popup>

        <Popup x:Name="QuickLookPopup" IsLightDismissEnabled="True" LightDismissOverlayMode="On">
            <Border Width="440" Height="560" Background="{ThemeResource SolidBackgroundFillColorBase}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                    CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="6"
                            Style="{StaticResource ToolbarIconButtonStyle}" Click="QuickLookCloseButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                    <views:PreviewPane x:Name="QuickLookPreview" Grid.Row="1" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
