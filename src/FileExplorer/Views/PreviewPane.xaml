<UserControl
    x:Class="FileExplorer.Views.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootPanel" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Preview" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

        <Grid x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7C3;" FontSize="40" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock Text="Select a file to preview" Opacity="0.6" HorizontalAlignment="Center" FontSize="12" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentState" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"
                   VerticalAlignment="Top" MaxHeight="360" />

            <FontIcon x:Name="AudioArt" Glyph="&#xE8D6;" FontSize="128" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

            <MediaPlayerElement x:Name="VideoPreview" Visibility="Collapsed" AreTransportControlsEnabled="True"
                                 VerticalAlignment="Top" MaxHeight="360">
                <MediaPlayerElement.TransportControls>
                    <MediaTransportControls x:Name="MediaControls" ShowAndHideAutomatically="False" />
                </MediaPlayerElement.TransportControls>
            </MediaPlayerElement>

            <WebView2 x:Name="PdfPreview" Visibility="Collapsed" MinHeight="360" />

            <ScrollViewer x:Name="TextScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TextPreview" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            </ScrollViewer>

            <ScrollViewer x:Name="CodeScroller" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CodeLineNumbers" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               TextAlignment="Right" Opacity="0.45" Margin="0,0,10,0" IsTextSelectionEnabled="False" />
                    <RichTextBlock x:Name="CodePreview" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   TextWrapping="NoWrap" />
                </Grid>
            </ScrollViewer>

            <Grid x:Name="HexPreview" Visibility="Collapsed" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="HexHeader" FontSize="11" Opacity="0.6" />
                <ScrollViewer Grid.Row="1" x:Name="HexScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="HexText" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                               TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>

            <StackPanel x:Name="IconPreview" Visibility="Collapsed" Spacing="8" VerticalAlignment="Top">
                <FontIcon x:Name="IconGlyph" FontSize="64" FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="DetailsPanel" Grid.Row="2" Spacing="4" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="KindText" Opacity="0.7" FontSize="12" />
            <TextBlock x:Name="SizeText" Opacity="0.7" FontSize="12" />
            <TextBlock x:Name="ModifiedText" Opacity="0.7" FontSize="12" />

            <StackPanel x:Name="ImageMetadataPanel" Spacing="4" Margin="0,8,0,0" Visibility="Collapsed">
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="ImageDimensionsText" Opacity="0.7" FontSize="12" />
                <TextBlock x:Name="ImageBitDepthText" Opacity="0.7" FontSize="12" />
                <TextBlock x:Name="ImageColorModelText" Opacity="0.7" FontSize="12" />
                <WebView2 x:Name="LocationMap" Visibility="Collapsed" Height="200" Margin="0,4,0,0" />
                <ScrollViewer x:Name="ExifScroller" MaxHeight="220" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="ExifList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap">
                                    <Run Text="{Binding Label}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Value}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
