<UserControl
    x:Class="FileExplorer.Views.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Preview" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

        <Grid x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7C3;" FontSize="40" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock Text="Select a file to preview" Opacity="0.6" HorizontalAlignment="Center" FontSize="12" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentState" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"
                   VerticalAlignment="Top" MaxHeight="360" />

            <ScrollViewer x:Name="TextScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TextPreview" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            </ScrollViewer>

            <StackPanel x:Name="IconPreview" Visibility="Collapsed" Spacing="8" VerticalAlignment="Top">
                <FontIcon x:Name="IconGlyph" FontSize="64" FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="DetailsPanel" Grid.Row="2" Spacing="4" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="KindText" Opacity="0.7" FontSize="12" />
            <TextBlock x:Name="SizeText" Opacity="0.7" FontSize="12" />
            <TextBlock x:Name="ModifiedText" Opacity="0.7" FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
