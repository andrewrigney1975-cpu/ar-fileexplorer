<UserControl
    x:Class="FileExplorer.Views.DrivePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileExplorer.Converters">

    <UserControl.Resources>
        <conv:UsedPercentToBrushConverter x:Key="UsedPercentToBrush" />
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="This PC" FontWeight="SemiBold" Margin="4,4,4,0" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <GridView x:Name="DriveGridView" SelectionMode="Single" Padding="4"
                      AutomationProperties.Name="Drives"
                      IsItemClickEnabled="True"
                      ItemClick="DriveGridView_ItemClick"
                      DoubleTapped="DriveGridView_DoubleTapped">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="220" Height="140" Padding="16" CornerRadius="6"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Grid.Row="0" Glyph="&#xEDA2;" FontSize="28"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Row="3" Value="{Binding UsedPercent}" Minimum="0" Maximum="100"
                                         Foreground="{Binding UsedPercent, Converter={StaticResource UsedPercentToBrush}}" />
                            <TextBlock Grid.Row="4" Text="{Binding UsageText}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>
    </Grid>
</UserControl>
