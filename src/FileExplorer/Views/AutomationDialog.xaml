<UserControl
    x:Class="FileExplorer.Views.AutomationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="680" HorizontalAlignment="Left" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folder watches -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Folder Watches" FontWeight="SemiBold" />
            <TextBlock x:Name="WatchesDisabledText"
                       Text="Folder watching is turned off in Preferences. Existing watches are kept but won't trigger until it's re-enabled."
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Text="Runs a script automatically when files are added to a watched folder. To add one, right-click a folder and choose &quot;Watch this folder...&quot;."
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

            <ListView x:Name="WatchesList" MaxHeight="220" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ScriptName}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}" Padding="4"
                                    Click="DeleteWatch_Click" Tag="{Binding Id}" ToolTipService.ToolTip="Stop watching">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="WatchesEmptyText" Text="No watched folders" Opacity="0.6" FontSize="12" />
        </StackPanel>

        <!-- Scheduled tasks -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Scheduled Tasks" FontWeight="SemiBold" />
            <TextBlock Text="Runs a script or sync task automatically on a repeating interval."
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

            <ListView x:Name="SchedulesList" MaxHeight="180" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ScheduleDisplay}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}" Padding="4"
                                    Click="DeleteSchedule_Click" Tag="{Binding Id}" ToolTipService.ToolTip="Remove schedule">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SchedulesEmptyText" Text="No scheduled tasks" Opacity="0.6" FontSize="12" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="ScheduleKindBox" Width="90" VerticalAlignment="Bottom" SelectionChanged="ScheduleKindBox_SelectionChanged">
                    <ComboBoxItem x:Name="ScheduleKindScriptItem" Content="Script" />
                    <ComboBoxItem x:Name="ScheduleKindSyncItem" Content="Sync" />
                </ComboBox>
                <ComboBox Grid.Column="1" x:Name="ScheduleTargetBox" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" PlaceholderText="Choose a script or sync task" />
                <NumberBox Grid.Column="2" x:Name="ScheduleIntervalBox" Width="110" Minimum="1" Value="60"
                           SpinButtonPlacementMode="Compact" Header="Every (min)" />
                <Button Grid.Column="3" Content="Add" VerticalAlignment="Bottom" Click="AddSchedule_Click" />
            </Grid>
        </StackPanel>

        <Button Grid.Row="2" x:Name="CloseButtonElement" Content="Close" Width="120" HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
</UserControl>
