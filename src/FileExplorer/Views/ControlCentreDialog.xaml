<UserControl
    x:Class="FileExplorer.Views.ControlCentreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ShortcutKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ShortcutGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Width="1300" Height="720" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Section nav -->
        <StackPanel Grid.Column="0" Spacing="4" Padding="8">
            <TextBlock Text="Control Centre" FontWeight="SemiBold" FontSize="16" Margin="6,4,0,10" />
            <ListView x:Name="SectionList" SelectionMode="Single"
                      AutomationProperties.Name="Control Centre sections" SelectionChanged="SectionList_SelectionChanged">
                <ListViewItem Content="Scripts" x:Name="ScriptsNavItem" />
                <ListViewItem Content="Sync Tasks" x:Name="SyncTasksNavItem" />
                <ListViewItem Content="Automation" x:Name="AutomationNavItem" />
                <ListViewItem Content="Thumbnails" x:Name="ThumbnailsNavItem" />
                <ListViewItem Content="Search Index" x:Name="SearchIndexNavItem" />
                <ListViewItem Content="Preferences" x:Name="PreferencesNavItem" />
                <ListViewItem Content="Keyboard Shortcuts" x:Name="KeyboardShortcutsNavItem" />
                <ListViewItem Content="About" x:Name="AboutNavItem" />
            </ListView>
        </StackPanel>

        <!-- Section content -->
        <Grid Grid.Column="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid x:Name="ScriptsHost" Visibility="Visible" />
                    <Grid x:Name="SyncTasksPanel" Visibility="Collapsed">
                        <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Sync Tasks" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Right-click a folder → &quot;Set sync source...&quot; then another folder → &quot;Set sync target&quot; to create a new one. Manage existing tasks here."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <ListView x:Name="SyncTasksList" SelectionMode="None" MaxHeight="560"
                                      AutomationProperties.Name="Sync tasks list">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PathsDisplay}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <CheckBox Content="Include hidden/system files" FontSize="11" Padding="4,0,0,0"
                                                          VerticalContentAlignment="Center"
                                                          IsChecked="{Binding IncludeHiddenSystemFiles, Mode=OneWay}"
                                                          Tag="{Binding Id}" Click="IncludeHiddenSystemFilesCheckBox_Click" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Run now" Click="RunSyncTask_Click" Tag="{Binding Id}" />
                                            <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}" Padding="4"
                                                    Click="RenameSyncTask_Click" Tag="{Binding}"
                                                    AutomationProperties.Name="Rename sync task" ToolTipService.ToolTip="Rename sync task">
                                                <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}" Padding="4"
                                                    Click="DeleteSyncTask_Click" Tag="{Binding Id}"
                                                    AutomationProperties.Name="Delete sync task" ToolTipService.ToolTip="Delete sync task">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="SyncTasksEmptyText" Text="No sync tasks" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AutomationHost" Visibility="Collapsed" />
                    <Grid x:Name="ThumbnailsPanel" Visibility="Collapsed">
                        <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Thumbnails" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Bitmap size thumbnails and folder previews are rendered/cached at, in pixels. Larger looks sharper on high-DPI displays but takes longer to generate and more disk space per cached folder. Changing this does not delete existing cache files - each is regenerated at the new size the next time its folder is opened."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <NumberBox x:Name="ThumbnailSizeBox" Header="Thumbnail size (px)" Minimum="48" Maximum="512"
                                       SpinButtonPlacementMode="Compact" SmallChange="16" LargeChange="64" Width="220" HorizontalAlignment="Left" />
                            <Button Content="Save" Click="SaveThumbnailSize_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="SearchIndexPanel" Visibility="Collapsed">
                        <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Search Index" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Powers &quot;Search Everywhere&quot; (F9, or the command palette) - an instant, substring search across every file and folder under whichever folders/drives you add below. Nothing is scanned until you add at least one - there is no index-everything default."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                            <ListView x:Name="SearchIndexRootsList" MaxHeight="200" SelectionMode="None"
                                      AutomationProperties.Name="Indexed folders list">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CountDisplay}" Opacity="0.6" FontSize="12" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}" Padding="4"
                                                    Click="RemoveSearchIndexRoot_Click" Tag="{Binding Path}"
                                                    AutomationProperties.Name="Stop indexing folder" ToolTipService.ToolTip="Stop indexing this folder">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="SearchIndexRootsEmptyText" Text="No indexed folders yet" Opacity="0.6" FontSize="12" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add folder..." Click="AddSearchIndexRoot_Click" />
                                <Button x:Name="RebuildSearchIndexButton" Content="Rebuild now" Click="RebuildSearchIndex_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="SearchIndexProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                <TextBlock x:Name="SearchIndexStatusText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PreferencesPanel" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Preferences" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Turning a feature off hides its toolbar button, context-menu entries, and command palette entries. Nothing already saved (scripts, sync tasks, watches, schedules) is deleted - it just stops surfacing in the UI until re-enabled."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                            <ToggleSwitch x:Name="TerminalToggle" Header="PowerShell terminal" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="SyncTasksToggle" Header="Sync Tasks" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="FolderWatchingToggle" Header="Folder watching" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="ScriptingToggle" Header="Scripting" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="FolderListingCacheToggle" Header="Folder listing cache" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="SearchIndexToggle" Header="Search Everywhere index" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="KeyboardShortcutsPanel" Visibility="Collapsed">
                        <!-- Fixed Width (not MaxWidth), same reasoning as AboutPanel below: this
                             panel sits inside a horizontally-auto-scrolling ScrollViewer, which
                             measures unconstrained content with infinite available width. -->
                        <StackPanel Spacing="6" Width="1088" HorizontalAlignment="Left">
                            <TextBlock Text="Keyboard Shortcuts" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Global accelerators work anywhere in the window; the driving pane is whichever one was last active, not literal focus."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <!-- Auto (not *) columns: each is only as wide as its own content, so the
                                 whole block hugs the left edge instead of stretching to fill the
                                 panel's full 1088px width with empty space between columns. -->
                            <Grid ColumnSpacing="28" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="ShortcutsColumn1" Grid.Column="0" Spacing="4" />
                                <StackPanel x:Name="ShortcutsColumn2" Grid.Column="1" Spacing="4" />
                                <StackPanel x:Name="ShortcutsColumn3" Grid.Column="2" Spacing="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AboutPanel" Visibility="Collapsed">
                        <!-- Fixed Width (not MaxWidth) is required here: this panel sits inside a
                             horizontally-auto-scrolling ScrollViewer, which measures unconstrained
                             content with infinite available width - without an explicit cap the
                             3-star-column tile Grid below blows out to some huge arbitrary width
                             instead of the dialog's real content area. 1088 = the fixed 1300-wide
                             dialog minus its 180 nav column minus 16+16 content padding. -->
                        <StackPanel Spacing="12" Width="1088" HorizontalAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock Text="enfyl Explorer" FontWeight="SemiBold" FontSize="22" />
                                <TextBlock x:Name="AboutVersionText" Opacity="0.7" FontSize="13" />
                                <TextBlock Text="A native dual-pane file explorer for Windows, built with WinUI 3 / Windows App SDK and .NET 8."
                                           Opacity="0.85" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE89A;" FontSize="20" FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Dual-Pane Browsing &amp; Workspaces" FontWeight="SemiBold" FontSize="14"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Two independently-navigable panes per tab, with drag-and-drop between them. Rename, duplicate, and reorder Workspace tabs to keep multiple projects organized side by side."
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                        <Border Height="110" CornerRadius="4" BorderThickness="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Image x:Name="DualPaneImage" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE943;" FontSize="20" FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Scripting" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Automate file operations with JavaScript, using a curated API for listing, moving, renaming, and tagging files - run on demand or wired up to a watch or schedule."
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                        <Border Height="110" CornerRadius="4" BorderThickness="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Image x:Name="ScriptingImage" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEAD6;" FontSize="20" FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Folder Watching" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Bind a script to a folder so it runs automatically whenever files are added - bursts of activity (like a batch copy) are debounced into a single run."
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                        <Border Height="110" CornerRadius="4" BorderThickness="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Image x:Name="WatchingImage" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE895;" FontSize="20" FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Sync Tasks" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Keep two folders mirrored with one-way sync, optionally including hidden/system files, run on demand or on an interval schedule."
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                        <Border Height="110" CornerRadius="4" BorderThickness="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Image x:Name="SyncImage" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEB05;" FontSize="20" FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Disk Space Analyser" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="See what's eating a drive with a donut chart and size-sorted breakdown, drilling down folder by folder down to individual files."
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                        <Border Height="110" CornerRadius="4" BorderThickness="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Image x:Name="AnalyserImage" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE95E;" FontSize="20" FontFamily="Segoe Fluent Icons"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Disk Benchmark" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Measure real sequential and random read/write throughput with unbuffered disk I/O, alongside drive hardware info pulled from WMI."
                                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                        <Border Height="110" CornerRadius="4" BorderThickness="1"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Image x:Name="BenchmarkImage" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="1" Content="Close" Width="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click" />
        </Grid>
    </Grid>
</UserControl>
