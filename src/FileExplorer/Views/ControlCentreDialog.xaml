<UserControl
    x:Class="FileExplorer.Views.ControlCentreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="1300" Height="720" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Section nav -->
        <StackPanel Grid.Column="0" Spacing="4" Padding="8">
            <TextBlock Text="Control Centre" FontWeight="SemiBold" FontSize="16" Margin="6,4,0,10" />
            <ListView x:Name="SectionList" SelectionMode="Single" SelectionChanged="SectionList_SelectionChanged">
                <ListViewItem Content="Scripts" x:Name="ScriptsNavItem" />
                <ListViewItem Content="Sync Tasks" x:Name="SyncTasksNavItem" />
                <ListViewItem Content="Automation" x:Name="AutomationNavItem" />
                <ListViewItem Content="Thumbnails" x:Name="ThumbnailsNavItem" />
                <ListViewItem Content="Preferences" x:Name="PreferencesNavItem" />
                <ListViewItem Content="About" x:Name="AboutNavItem" />
            </ListView>
        </StackPanel>

        <!-- Section content -->
        <Grid Grid.Column="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid x:Name="ScriptsHost" Visibility="Visible" />
                    <Grid x:Name="SyncTasksPanel" Visibility="Collapsed">
                        <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Sync Tasks" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Right-click a folder → &quot;Set sync source...&quot; then another folder → &quot;Set sync target&quot; to create a new one. Manage existing tasks here."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <ListView x:Name="SyncTasksList" SelectionMode="None" MaxHeight="560">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PathsDisplay}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Run now" Click="RunSyncTask_Click" Tag="{Binding Id}" />
                                            <Button Grid.Column="2" Style="{StaticResource ToolbarIconButtonStyle}" Padding="4"
                                                    Click="DeleteSyncTask_Click" Tag="{Binding Id}" ToolTipService.ToolTip="Delete sync task">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="SyncTasksEmptyText" Text="No sync tasks" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AutomationHost" Visibility="Collapsed" />
                    <Grid x:Name="ThumbnailsPanel" Visibility="Collapsed">
                        <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Thumbnails" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Bitmap size thumbnails and folder previews are rendered/cached at, in pixels. Larger looks sharper on high-DPI displays but takes longer to generate and more disk space per cached folder. Changing this does not delete existing cache files - each is regenerated at the new size the next time its folder is opened."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <NumberBox x:Name="ThumbnailSizeBox" Header="Thumbnail size (px)" Minimum="48" Maximum="512"
                                       SpinButtonPlacementMode="Compact" SmallChange="16" LargeChange="64" Width="220" HorizontalAlignment="Left" />
                            <Button Content="Save" Click="SaveThumbnailSize_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PreferencesPanel" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Preferences" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Turning a feature off hides its toolbar button, context-menu entries, and command palette entries. Nothing already saved (scripts, sync tasks, watches, schedules) is deleted - it just stops surfacing in the UI until re-enabled."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                            <ToggleSwitch x:Name="TerminalToggle" Header="PowerShell terminal" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="SyncTasksToggle" Header="Sync Tasks" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="FolderWatchingToggle" Header="Folder watching" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                            <ToggleSwitch x:Name="ScriptingToggle" Header="Scripting" OnContent="On" OffContent="Off" Toggled="FeatureToggle_Toggled" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AboutPanel" Visibility="Collapsed">
                        <StackPanel Spacing="6" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="arExx Pro" FontWeight="SemiBold" FontSize="22" />
                            <TextBlock x:Name="AboutVersionText" Opacity="0.7" FontSize="13" />
                            <TextBlock Text="A native dual-pane file explorer for Windows, built with WinUI 3 / Windows App SDK and .NET 8."
                                       Opacity="0.85" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="1" Content="Close" Width="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click" />
        </Grid>
    </Grid>
</UserControl>
