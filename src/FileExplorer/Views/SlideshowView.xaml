<UserControl
    x:Class="FileExplorer.Views.SlideshowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent" IsTabStop="True" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image x:Name="MainImage" Stretch="Uniform" />

            <TextBlock x:Name="EmptyText" Text="Couldn't load image" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />

            <Border x:Name="CaptionBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Background="#99000000" CornerRadius="4" Padding="12,4">
                <TextBlock x:Name="CaptionText" Foreground="White" FontSize="12" />
            </Border>

            <Button x:Name="PrevButton" Click="Prev_Click" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="48" Height="72" Margin="8,0,0,0" Background="#66000000" Foreground="White"
                    BorderThickness="0" AutomationProperties.Name="Previous image">
                <FontIcon Glyph="&#xE76B;" FontSize="18" />
            </Button>
            <Button x:Name="NextButton" Click="Next_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="48" Height="72" Margin="0,0,8,0" Background="#66000000" Foreground="White"
                    BorderThickness="0" AutomationProperties.Name="Next image">
                <FontIcon Glyph="&#xE76C;" FontSize="18" />
            </Button>
            <Button x:Name="CloseButton" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8" Background="#66000000" Foreground="White" BorderThickness="0"
                    AutomationProperties.Name="Close slideshow">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="#B3000000" Padding="0,6">
            <ScrollViewer x:Name="StripScroller" Height="84" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled">
                <StackPanel x:Name="StripPanel" Orientation="Horizontal" Spacing="6" Padding="8,0" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
