<UserControl
    x:Class="FileExplorer.Views.DiskSpaceAnalyserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileExplorer.Converters">

    <Grid Width="1300" Height="800" Padding="16" RowSpacing="12">
        <Grid.Resources>
            <conv:UsedPercentToBrushConverter x:Key="UsedPercentToBrush" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, breadcrumb (breakdown mode only), export + close -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Disk Space Analyser" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />

            <StackPanel x:Name="BreadcrumbPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        Margin="24,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BigFilesButton" Content="Find big files..." Click="BigFilesButton_Click" Visibility="Collapsed" />
                <Button x:Name="ExportButton" Content="Export listing (JSON)" Click="ExportButton_Click" Visibility="Collapsed" />
                <Button Content="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <!-- Drive selection grid -->
            <Grid x:Name="DriveGridPanel" Visibility="Visible">
                <GridView x:Name="DriveGridView" SelectionMode="Single"
                          AutomationProperties.Name="Drives" DoubleTapped="DriveGridView_DoubleTapped">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" Height="140" Padding="16" CornerRadius="6"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Grid.Row="0" Glyph="&#xEDA2;" FontSize="28"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Row="3" Value="{Binding UsedPercent}" Minimum="0" Maximum="100"
                                             Foreground="{Binding UsedPercent, Converter={StaticResource UsedPercentToBrush}}" />
                                <TextBlock Grid.Row="4" Text="{Binding UsageText}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Drive/folder breakdown: donut chart + size-descending list -->
            <Grid x:Name="BreakdownPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Canvas x:Name="ChartCanvas" Width="680" Height="680"
                            AutomationProperties.Name="Folder size breakdown chart"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="HoverPopover" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" MaxWidth="260" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="HoverName" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="HoverKind" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="HoverSize" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="HoverAttributes" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="HoverCreated" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="HoverModified" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="HoverOwner" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                    <TextBlock x:Name="LoadingText" Text="Analysing..." FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>

                <ListView x:Name="EntriesList" Grid.Column="1" SelectionMode="Single"
                          AutomationProperties.Name="Folder contents by size" DoubleTapped="EntriesList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontSize="14" FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          Glyph="{Binding Glyph}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="4,0" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Big files: recursive threshold search under the current location, with checkbox
                 multi-select and a delete-selected action. -->
            <Grid x:Name="BigFilesPanel" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="‹ Back to breakdown" Click="BigFilesBack_Click" />
                    <TextBlock Text="Find files at least" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <NumberBox x:Name="BigFilesThresholdBox" Value="100" Minimum="0" SpinButtonPlacementMode="Compact"
                               SmallChange="10" LargeChange="100" Width="110"
                               AutomationProperties.Name="Minimum file size" />
                    <ComboBox x:Name="BigFilesUnitCombo" SelectedIndex="1" Width="90"
                              AutomationProperties.Name="Size unit">
                        <ComboBoxItem Content="KB" />
                        <ComboBoxItem Content="MB" />
                        <ComboBoxItem Content="GB" />
                    </ComboBox>
                    <Button Content="Scan" Click="BigFilesScan_Click" Margin="8,0,0,0" />
                    <ProgressRing x:Name="BigFilesProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" Margin="8,0,0,0" />
                    <TextBlock x:Name="BigFilesStatusText" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox x:Name="BigFilesSelectAllCheckBox" Content="Select all" IsThreeState="True" Click="BigFilesSelectAll_Click" />
                    <Button x:Name="BigFilesDeleteButton" Content="Delete selected" Click="BigFilesDelete_Click" IsEnabled="False" />
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="8" Padding="30,0,16,4" Opacity="0.6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="Path" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="Size" FontSize="12" HorizontalAlignment="Right" />
                </Grid>

                <ListView x:Name="BigFilesList" Grid.Row="3" SelectionMode="None"
                          AutomationProperties.Name="Big files found">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Tag="{Binding}" Click="BigFileCheckBox_Click" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis"
                                           Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="12" Opacity="0.7"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="BigFilesEmptyText" Grid.Row="3" Text="No files found at or over that size."
                           Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
