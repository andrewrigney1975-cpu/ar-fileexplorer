<UserControl
    x:Class="FileExplorer.Views.DiskBenchmarkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileExplorer.Converters">

    <Grid Width="1300" Height="800" Padding="16" RowSpacing="12">
        <Grid.Resources>
            <conv:UsedPercentToBrushConverter x:Key="UsedPercentToBrush" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Disk Benchmark" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DriveNameText" FontWeight="SemiBold" Visibility="Collapsed" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ChangeDriveButton" Content="Change drive" Click="ChangeDriveButton_Click" Visibility="Collapsed" />
                <Button x:Name="ExportButton" Content="Export results (JSON)" Click="ExportButton_Click"
                        Visibility="Collapsed" IsEnabled="False" />
                <Button Content="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <!-- Drive selection grid -->
            <Grid x:Name="DriveGridPanel" Visibility="Visible">
                <GridView x:Name="DriveGridView" SelectionMode="Single"
                          AutomationProperties.Name="Drives" DoubleTapped="DriveGridView_DoubleTapped">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" Height="140" Padding="16" CornerRadius="6"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Grid.Row="0" Glyph="&#xEDA2;" FontSize="28"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="0,8,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar Grid.Row="3" Value="{Binding UsedPercent}" Minimum="0" Maximum="100"
                                             Foreground="{Binding UsedPercent, Converter={StaticResource UsedPercentToBrush}}" />
                                <TextBlock Grid.Row="4" Text="{Binding UsageText}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Benchmark results: bar chart + hardware info -->
            <Grid x:Name="ResultsPanel" Visibility="Collapsed" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="500" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Canvas x:Name="ChartCanvas" Grid.Column="0" Width="860" Height="680"
                        AutomationProperties.Name="Benchmark results chart"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Border Grid.Column="1" Padding="16" CornerRadius="6" VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Drive information" FontWeight="SemiBold" FontSize="14" />
                        <StackPanel x:Name="InfoRows" Spacing="6" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
