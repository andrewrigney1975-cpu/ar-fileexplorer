<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FileExplorer</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <!-- Needed for aligned-buffer pointer handling in DiskBenchmarkService's unbuffered disk I/O
         (FILE_FLAG_NO_BUFFERING requires 4096-byte-aligned buffers/offsets). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyName>enfyl-explorer</AssemblyName>
    <Product>enfyl Explorer</Product>
    <AssemblyTitle>enfyl Explorer</AssemblyTitle>

    <!-- App version: major.minor.build (e.g. 1.00.000). Bump Major/Minor by hand for a real
         release; Build auto-increments on every build via the SetBuildNumber target below. -->
    <AppVersionMajor>1</AppVersionMajor>
    <AppVersionMinor>0</AppVersionMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="Jint" Version="4.16.0" />
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
    <PackageReference Include="LibHeif.Native.win-x64" Version="1.15.1" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\About\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Auto-incrementing build counter, combined with the hand-set Major/Minor above into a
       major.minor.build version string (e.g. "1.00.037") and embedded as an assembly metadata
       attribute so AppVersionInfo can read it back at runtime for the Control Centre's About tab. -->
  <Target Name="SetBuildNumber" BeforeTargets="GetAssemblyAttributes;CoreGenerateAssemblyInfo">
    <PropertyGroup>
      <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_BuildNumberLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CurrentBuildNumber>@(_BuildNumberLines)</_CurrentBuildNumber>
      <_CurrentBuildNumber Condition="'$(_CurrentBuildNumber)' == ''">0</_CurrentBuildNumber>
      <BuildNumber>$([MSBuild]::Add($(_CurrentBuildNumber), 1))</BuildNumber>
      <AppVersionString>$([System.String]::Format('{0}.{1:D2}.{2:D3}', $(AppVersionMajor), $(AppVersionMinor), $(BuildNumber)))</AppVersionString>
      <!-- Drives the exe's real File version/Product version (Explorer's Properties dialog), not
           just the in-app About readout - without these the SDK defaults File version to a fixed
           1.0.0.0 and Product version to "1.0.0+<git-hash>", neither of which ever changes. -->
      <FileVersion>$(AppVersionMajor).$(AppVersionMinor).0.$(BuildNumber)</FileVersion>
      <InformationalVersion>$(AppVersionString)</InformationalVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" />
    <!-- CoreGenerateAssemblyInfo's up-to-date check hashes the @(AssemblyAttribute) items as
         computed by GetAssemblyAttributes, which runs (as one of CoreGenerateAssemblyInfo's own
         DependsOnTargets) BEFORE this BeforeTargets-scheduled target - so that hash never reflects
         a property we set here, and the generated file was silently going stale build after build.
         Deleting the output forces regeneration unconditionally regardless of that hash. -->
    <Delete Files="$(GeneratedAssemblyInfoFile)" Condition="Exists('$(GeneratedAssemblyInfoFile)')" />
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>AppVersion</_Parameter1>
        <_Parameter2>$(AppVersionString)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
