<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Link (not copy) the app's WinUI-free pure-logic source files, so tests always compile
       against the real implementation rather than a duplicate that can drift. Building the main
       FileExplorer.csproj requires VS's MSBuild (see build_toolchain notes) because it references
       the Windows App SDK; this project deliberately only links files with zero WinUI/WindowsAppSDK
       dependency so it stays buildable/testable with plain `dotnet test`. -->
  <ItemGroup>
    <Compile Include="..\..\src\FileExplorer\Services\RemotePathService.cs" Link="Sources\RemotePathService.cs" />
    <Compile Include="..\..\src\FileExplorer\Services\FileOperationService.cs" Link="Sources\FileOperationService.cs" />
    <Compile Include="..\..\src\FileExplorer\Services\JsonFileStore.cs" Link="Sources\JsonFileStore.cs" />
    <Compile Include="..\..\src\FileExplorer\Helpers\FuzzyMatcher.cs" Link="Sources\FuzzyMatcher.cs" />
    <Compile Include="..\..\src\FileExplorer\Models\RemoteProtocol.cs" Link="Sources\RemoteProtocol.cs" />
  </ItemGroup>

</Project>